SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=*

POSTGRES_DB=futbolgo
POSTGRES_USER=futbolgo
POSTGRES_PASSWORD=futbolgo
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4673

# BotFather token + username (without @). Required for real OTP delivery,
# Telegram Mini App auth, and the bot process. Leave TELEGRAM_BOT_TOKEN empty
# and OTP_DEBUG_MODE=True to develop the frontend without a bot at all.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# The deployed frontend URL (Telegram Mini App target + CORS/menu button).
FRONTEND_URL=https://footbal-app-five.vercel.app/

# When True, /auth/otp/request returns the code directly in the response body
# instead of sending it via Telegram — unblocks frontend dev before the bot exists.
# Must be False in production.
OTP_DEBUG_MODE=True
